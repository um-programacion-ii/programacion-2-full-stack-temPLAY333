{
"creado": true,
"resultado": "Usuario creado",
"token":
"eyJhbGciOiJITzUxMiJ9.eyJzdWIiOiJmZXJuYW5kbyIsImV4cCI6MTc1ODIyMTY5
MSwiYXV0aCI6IlJPTEVfVVNFUiIsImlhdCI6MTc1NTYyOTY5MX0.DtQ5-CqQj_tysA
